# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env' and fill in your actual private values.
# IMPORTANT: Never commit the actual '.env' file to Git!
# ==============================================================================

# --- SSH Target Server Configuration ---
SSH_HOST=192.168.1.100
SSH_USER=deploy
SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
SSH_PASSPHRASE=""

# --- Application Specific Secrets (Optional) ---
# Any additional environment variables needed by your app in docker-compose:
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
