# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env' and fill in your actual private values.
# IMPORTANT: Never commit the actual '.env' file to Git!
# ==============================================================================

# --- SSH Target Server Configuration ---
SSH_HOST=192.168.1.100
SSH_USER=deploy

# Specify the path to your private SSH key (supports ~ or absolute path)
# The sync-secrets script will automatically read this file and upload it as SSH_KEY
SSH_KEY_PATH=~/.ssh/id_ed25519
SSH_PASSPHRASE=""

# --- Application Specific Secrets (Optional) ---
# Any additional environment variables needed by your app in docker-compose:
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
